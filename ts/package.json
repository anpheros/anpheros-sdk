{
  "name": "@anpheros/sdk",
  "version": "0.1.2",
  "description": "TypeScript client for Anpheros Platform, interoperable medical-data infrastructure: HL7 FHIR R4 records, patient consent (OAuth 2.1 / SMART on FHIR), provenance and an AI context API.",
  "license": "Apache-2.0",
  "homepage": "https://developers.anpheros.com/guides/sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anpheros/anpheros-sdk.git",
    "directory": "ts"
  },
  "bugs": {
    "url": "https://github.com/anpheros/anpheros-sdk/issues"
  },
  "keywords": [
    "fhir",
    "oauth",
    "smart-on-fhir",
    "api-client",
    "anpheros",
    "healthcare",
    "hl7",
    "medical-data",
    "patient-records",
    "medical",
    "interoperability"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/test",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
